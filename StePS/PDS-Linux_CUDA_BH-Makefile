# Builds build/StePS_CUDA_BH: the PDS Barnes-Hut tree force on the GPU
# (forces_pds_bh_cuda / ForceKernel_pds_bh in forces_cuda.cu).  Activate the
# stepsic conda env first.  build/ is shared with the other StePS makefiles
# (same object names, different macros), so run `make -f <this> clean` or
# `rm -f build/*.o` when switching builds.

#------------------------------- GPU and precision options for the force calculation
USING_CUDA = YES
#OPT += -DUSE_SINGLE_PRECISION

#------------------------------- Force calculation method
# Barnes-Hut (octree) with opening angle theta.  theta ~ 0.3-0.35 gives ~0.5-1%
# force accuracy on the PDS topology (see examples/pds_tests/pds_bh_prototype*).
OPT += -DUSE_BH=0.3

#------------------------------- Topology
OPT += -DPOINCARE_DODECAHEDRAL # Poincare Dodecahedral Space topology (S^3/I*). EXPERIMENTAL.
EWALD_INTERPOLATION_ORDER=2# Not used in PDS mode; left at default.

#------------------------------- Option for enabling HDF5 I/O
OPT += -DHAVE_HDF5

#------------------------------- Parametrization of the background cosmology
OPT += -DCOSMOPARAM=0	#0: standard Lambda-CDM parametrization (default)

#------------------------------- Compiler
CXX = g++

#------------------------------- Location of the MPI libraries (stepsic conda env)
MPI_LIBS = -L$(CONDA_PREFIX)/lib -lmpi -lhwloc
MPI_INC = -I$(CONDA_PREFIX)/include

#------------------------------- Location of the CUDA Toolkit (stepsic conda env)
CUDA_PATH       ?= $(CONDA_PREFIX)
CUDA_ARCH       ?= sm_90

#------------------------------- Location of the HDF5 libraries (stepsic conda env)
HDF5_LIBS = -L$(CONDA_PREFIX)/lib -lhdf5
HDF5_INC  = -I$(CONDA_PREFIX)/include

#---------------- Do not edit beyond this line! ----------------

SRC_DIR = ./src
BUILD_DIR = ./build

MAKE_BUILD_DIR = @mkdir -p $(BUILD_DIR)

CPPSTD = c++17

SRC = $(SRC_DIR)/main.cc $(SRC_DIR)/inputoutput.cc $(SRC_DIR)/ewald_space.cc step.cc $(SRC_DIR)/read_paramfile.cc $(SRC_DIR)/friedmann_solver.cc $(SRC_DIR)/read_gadget_ic.cc $(SRC_DIR)/utils.cc
DEPS = $(SRC_DIR)/global_variables.h
OBJ = $(BUILD_DIR)/main.o $(BUILD_DIR)/inputoutput.o $(BUILD_DIR)/ewald_space.o $(BUILD_DIR)/step.o $(BUILD_DIR)/read_paramfile.o $(BUILD_DIR)/friedmann_solver.o $(BUILD_DIR)/read_gadget_ic.o $(BUILD_DIR)/utils.o

COMPILERVERSION=$(shell $(CXX) --version | head -1)
GITCOMMIT_ID=$(shell git rev-parse HEAD)
GITBRANCH=$(shell git rev-parse --abbrev-ref HEAD)
DATE=$(shell date +'%Y-%m-%d %A %H:%M %Z')
BUILD_NUMBER_LDFLAGS  = -DBUILD_DATE='"$(DATE)"' -DPROGRAM_VERSION=$(VERSION) -DCOMPILER_VERSION='"$(COMPILERVERSION)"' -DGIT_COMMIT_ID='"$(GITCOMMIT_ID)"' -DGIT_BRANCH='"$(GITBRANCH)"'
CFLAGS = -Wno-long-long -Wno-unused-result -lm -Wall -ansi -pedantic -O3 -ffast-math -std=${CPPSTD} -fopenmp -lgomp -DOMPI_SKIP_MPICXX

MPI_COMPILE_FLAGS = $(shell mpicxx --showme:compile)
MPI_LINK_FLAGS = $(shell mpicxx --showme:link)

OPT += -DEWALD_INTERPOLATION_ORDER=$(EWALD_INTERPOLATION_ORDER)
OPT += -DUSE_CUDA
BUILD_NUMBER_LDFLAGS += -DPROGRAMNAME='"StePS_CUDA_BH"'

$(info This is the StePS $(VERSION) PDS Barnes-Hut (CUDA) Makefile.)
$(info Compiling with $(CXX) ($(COMPILERVERSION)) + nvcc from $(CUDA_PATH), arch $(CUDA_ARCH).)
$(info Build options: $(OPT))
$(info )

NVCC = $(CUDA_PATH)/bin/nvcc -ccbin
CUDAFLAGS = -arch=$(CUDA_ARCH) -Xcompiler -fopenmp -lineinfo --compiler-options --std=${CPPSTD} --compiler-options -Wall -O3 -lm -Xcompiler -pthread
CUDALDFLAGS = -Xlinker -rpath -Xlinker $(CONDA_PREFIX)/lib -Xlinker --enable-new-dtags -lgomp
CUDA_INC = -I$(CUDA_PATH)/include

SRC += $(SRC_DIR)/forces_cuda.cu
OBJ += $(BUILD_DIR)/forces_cuda.o
PROG = $(BUILD_DIR)/StePS_CUDA_BH

$(PROG): $(OBJ)
	$(MAKE_BUILD_DIR)
	$(NVCC) $(CXX) $(CUDAFLAGS) $(CUDALDFLAGS) $(CUDA_INC) $(BUILD_NUMBER_LDFLAGS) $(OPT) -o $(PROG) $(OBJ) $(HDF5_INC) $(HDF5_LIBS) $(MPI_LIBS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cc
	$(MAKE_BUILD_DIR)
	$(CXX) $(CFLAGS) $(CUDA_INC) $(LDFLAGS) $(MPI_COMPILE_FLAGS) $(MPI_LINK_FLAGS) $(HDF5_LIBS) $(HDF5_INC) $(BUILD_NUMBER_LDFLAGS) $(OPT) -o $@ -c $<

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cu
	$(MAKE_BUILD_DIR)
	$(NVCC) $(CXX) $(CUDAFLAGS) $(CUDA_INC) $(MPI_INC) $(BUILD_NUMBER_LDFLAGS) $(OPT) -o $@ -c $<

clean:
	rm -fv $(OBJ) $(PROG)
