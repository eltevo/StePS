#------------------------------- GPU and precision options for the force calculation
USING_CUDA = YES
OPT += -DUSE_SINGLE_PRECISION

#------------------------------- Options for the force calculation method (if everthing is commented out, direct summation is used)
#OPT += -DUSE_BH=0.25 # Use the Barnes-Hut (OctTree) method for force calculation with an opening angle of 0.25. (Recommended value is 0.25)
#OPT += -DRANDOMIZE_BH=123456 # Randomize the BH tree to avoid artifacts. Only works with the BH method, and it is highly recommended to use it.
#OPT += -DSAVE_ACCELERATIONS # Save the accelerations to snapshots. This is useful for testing force calculation accuracy. Only works with HDF5 output.

#------------------------------- Options for boundary conditions
#OPT += -DPERIODIC # Periodic boundary conditions (T^3 topological manifold)
#OPT += -DPERIODIC_Z # Periodic boundary conditions in the z-direction only (S^1 x R^2 topological manifold)
#OPT += -DPERIODIC_Z_RSPACELOOKUP # Using direct real-space summation with large cutoff (N>10^3) to generate the periodic lookup table. Otherwise, Tornberg (2015) Ewald summation method will be used for lookup table calculation (only for cylindrical periodic BCs).
#OPT += -DPERIODIC_Z_NOLOOKUP # Enable direct periodic real-space summation without using a lookup table (only for cylindrical periodic BCs), otherwise lookup table method is used.
EWALD_INTERPOLATION_ORDER = 2# Interpolation order for the Ewald force correction table (0: NGP, 2: CIC, 4: TSC). Higher order = more accurate but slower. Default: 2 (CIC) for speed; for best accuracy use 4 (TSC).

#------------------------------- Option for enabling HDF5 I/O
OPT += -DHAVE_HDF5

#------------------------------- Option for turning on glass making mode
#OPT += -DGLASS_MAKING

#------------------------------- Parametrization of the background cosmology
OPT += -DCOSMOPARAM=0	#0: standard Lambda-CDM parametrization (default)
			#1: wCDM dark energy parametrization
			#2: w0waCDM (a.k.a. CPL) dark energy parametrization
			#-1: the expansion history will be read from an external file

#------------------------------- Compiler
CXX ?= icpc

#------------------------------- Location of the MPI libraries
MPI_LIBS = -L/opt/intel/compilers_and_libraries_2018.2.199/linux/mpi/intel64/lib -Xlinker --enable-new-dtags -Xlinker -rpath -Xlinker /opt/intel/compilers_and_libraries_2018.2.199/linux/mpi/intel64/lib/release_mt -Xlinker -rpath -Xlinker /opt/intel/compilers_and_libraries_2018.2.199/linux/mpi/intel64/lib -Xlinker -rpath -Xlinker /opt/intel/mpi-rt/2017.0.0/intel64/lib/release_mt -Xlinker -rpath -Xlinker /opt/intel/mpi-rt/2017.0.0/intel64/lib -lmpicxx -lmpifort -lmpi -lmpigi -ldl -lrt -lpthread
MPI_INC = -I/opt/intel/compilers_and_libraries_2018.2.199/linux/mpi/intel64/include

#------------------------------- Location of the CUDA Toolkit
CUDA_PATH ?= /opt/apps/cuda/11.0

#------------------------------- Location of the HDF5 libraries
HDF5_LIBS = -L/opt/apps/intel18/hdf5/1.10.4/x86_64/lib -lhdf5
HDF5_INC = -I/opt/apps/intel18/hdf5/1.10.4/x86_64/include

#---------------- Do not edit beyond this line! ----------------

SRC_DIR = ./src
BUILD_DIR = ./build

MAKE_BUILD_DIR = @mkdir -p $(BUILD_DIR)

CPPSTD = c++17

SRC = $(SRC_DIR)/main.cc $(SRC_DIR)/inputoutput.cc $(SRC_DIR)/ewald_space.cc $(SRC_DIR)/step.cc $(SRC_DIR)/read_paramfile.cc $(SRC_DIR)/friedmann_solver.cc $(SRC_DIR)/read_gadget_ic.cc $(SRC_DIR)/utils.cc
DEPS = $(SRC_DIR)/global_variables.h
OBJ = $(BUILD_DIR)/main.o $(BUILD_DIR)/inputoutput.o $(BUILD_DIR)/ewald_space.o $(BUILD_DIR)/step.o $(BUILD_DIR)/read_paramfile.o $(BUILD_DIR)/friedmann_solver.o $(BUILD_DIR)/read_gadget_ic.o $(BUILD_DIR)/utils.o

COMPILERVERSION = $(shell $(CXX) --version | head -1)
GITCOMMIT_ID = $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
GITBRANCH = $(shell git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)
DATE = $(shell date +'%Y-%m-%d %A %H:%M %Z')

BUILD_NUMBER_CPPFLAGS = -DBUILD_DATE='"$(DATE)"' -DPROGRAM_VERSION=$(VERSION) -DCOMPILER_VERSION='"$(COMPILERVERSION)"' -DGIT_COMMIT_ID='"$(GITCOMMIT_ID)"' -DGIT_BRANCH='"$(GITBRANCH)"'
CPPFLAGS = $(BUILD_NUMBER_CPPFLAGS) $(OPT)
CXXFLAGS = -Wno-long-long -Wall -pedantic -O3 -std=$(CPPSTD) -qopenmp -pthread
LDFLAGS =
LDLIBS = -lm

IMPI_COMPILE_FLAGS = $(shell mpiicpc -compile-info 2>/dev/null || echo icpc $(MPI_INC))
MPI_COMPILE_FLAGS = $(subst icpc, ,$(IMPI_COMPILE_FLAGS))
IMPI_LINK_FLAGS = $(shell mpiicpc -link-info 2>/dev/null || echo icpc $(MPI_LIBS))
MPI_LINK_FLAGS = $(subst icpc, ,$(IMPI_LINK_FLAGS))

#------------------------------- Printing out some info
$(info This is the StePS $(VERSION) Makefile.)
$(info ----------------------------------------)
$(info Basic compilation settings:)
ifeq ($(USING_CUDA), YES)
$(info Compiling StePS with $(CXX) ($(COMPILERVERSION)) with CUDA support from $(CUDA_PATH))
else
$(info Compiling StePS with $(CXX) ($(COMPILERVERSION)) without CUDA support (CPU only mode))
endif
$(info MPI compile flags: $(MPI_COMPILE_FLAGS))
$(info MPI link flags: $(MPI_LINK_FLAGS))
$(info C++ compiler flags: $(CXXFLAGS))
$(info Build options: $(OPT))
$(info ----------------------------------------)
$(info )

#------------------------------- Ewald interpolation order setting
ifeq ($(EWALD_INTERPOLATION_ORDER),0)
OPT += -DEWALD_INTERPOLATION_ORDER=0
else ifeq ($(EWALD_INTERPOLATION_ORDER),2)
OPT += -DEWALD_INTERPOLATION_ORDER=2
else ifeq ($(EWALD_INTERPOLATION_ORDER),4)
OPT += -DEWALD_INTERPOLATION_ORDER=4
else
$(info Warning: Unsupported EWALD_INTERPOLATION_ORDER value ($(EWALD_INTERPOLATION_ORDER)). Supported values are 0, 2, and 4. Setting to default value of 4. (TSC))
OPT += -DEWALD_INTERPOLATION_ORDER=4
endif

CPPFLAGS = $(BUILD_NUMBER_CPPFLAGS) $(OPT)

ifeq ($(USING_CUDA), YES)

#------------------------------- CUDA build settings
OPT += -DUSE_CUDA
BUILD_NUMBER_CPPFLAGS += -DPROGRAMNAME='"StePS_CUDA"'
CPPFLAGS = $(BUILD_NUMBER_CPPFLAGS) $(OPT)

NVCC = $(CUDA_PATH)/bin/nvcc
NVCC_HOST_COMPILER = $(CXX)
NVCCFLAGS = -ccbin $(NVCC_HOST_COMPILER) -std=$(CPPSTD) -O3 -lineinfo -Xcompiler=-Wall -Xcompiler=-qopenmp -Xcompiler=-pthread
NVCCLDFLAGS = -Xcompiler=-qopenmp -Xcompiler=-pthread
CUDA_INC = -I$(CUDA_PATH)/include

SRC += $(SRC_DIR)/forces_cuda.cu
OBJ += $(BUILD_DIR)/forces_cuda.o
PROG = $(BUILD_DIR)/StePS_CUDA

$(PROG): $(OBJ)
	$(MAKE_BUILD_DIR)
	$(NVCC) $(NVCCFLAGS) $(NVCCLDFLAGS) $(CUDA_INC) $(LDFLAGS) $(CPPFLAGS) -o $(PROG) $(OBJ) $(HDF5_LIBS) $(MPI_LIBS) $(LDLIBS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cc $(DEPS)
	$(MAKE_BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(CUDA_INC) $(MPI_COMPILE_FLAGS) $(HDF5_INC) $(CPPFLAGS) -o $@ -c $<

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cu $(DEPS)
	$(MAKE_BUILD_DIR)
	$(NVCC) $(NVCCFLAGS) $(CUDA_INC) $(MPI_INC) $(HDF5_INC) $(CPPFLAGS) -o $@ -c $<

clean:
	rm -fv $(OBJ) $(PROG)

else

BUILD_NUMBER_CPPFLAGS += -DPROGRAMNAME='"StePS"'
CPPFLAGS = $(BUILD_NUMBER_CPPFLAGS) $(OPT)

SRC += $(SRC_DIR)/forces.cc
OBJ += $(BUILD_DIR)/forces.o
PROG = $(BUILD_DIR)/StePS

$(PROG): $(OBJ)
	$(MAKE_BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) $(CPPFLAGS) -o $(PROG) $(OBJ) $(HDF5_LIBS) $(MPI_LINK_FLAGS) $(LDLIBS)

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cc $(DEPS)
	$(MAKE_BUILD_DIR)
	$(CXX) $(CXXFLAGS) $(MPI_COMPILE_FLAGS) $(HDF5_INC) $(CPPFLAGS) -o $@ -c $<

clean:
	rm -fv $(OBJ) $(PROG)

endif
